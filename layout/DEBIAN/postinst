#!/bin/sh
# iOS 8 rootful app: make missing installation files visible as a real error.
LOG=/var/mobile/Media/BiliLite-install.log
if [ ! -d /Applications/BiliLite.app ] || [ ! -f /Applications/BiliLite.app/Info.plist ] || [ ! -x /Applications/BiliLite.app/BiliLite ]; then
  echo "BiliLite 0.1.4 ERROR: missing application files at /Applications/BiliLite.app" >> "$LOG"
  exit 1
fi
{
  echo "BiliLite 0.1.4: application files installed correctly"
  date
  ls -ld /Applications/BiliLite.app
  ls -l /Applications/BiliLite.app/BiliLite
  if [ -x /usr/bin/uicache ]; then
    /usr/bin/uicache
    echo "uicache exit code: $?"
  else
    echo "uicache unavailable: SpringBoard cache may need a manual refresh"
  fi
  echo "Installation script finished"
} >> "$LOG" 2>&1
exit 0
