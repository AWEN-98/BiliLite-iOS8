#!/bin/sh
# Legacy iOS 8 registration with visible diagnostics for iFile/Cydia.
APP=/Applications/BiliLite.app
LOG=/var/mobile/Media/BiliLite-install.log
echo "BiliLite 0.1.5 post-install check" 
if [ ! -d "$APP" ] || [ ! -f "$APP/Info.plist" ] || [ ! -x "$APP/BiliLite" ]; then
    echo "ERROR: APP_FILES_MISSING at $APP" >&2
    echo "APP_FILES_MISSING: $APP" >> "$LOG"
    exit 1
fi
echo "APP_FILES_PRESENT: $APP" | tee -a "$LOG"
if [ -x /usr/bin/uicache ]; then
    /usr/bin/uicache >> "$LOG" 2>&1
    CODE=$?
    echo "UICACHE_EXIT=$CODE" | tee -a "$LOG"
else
    echo "UICACHE_NOT_FOUND: update UIKit Tools in Cydia if icons do not show" | tee -a "$LOG"
fi
echo "POSTINSTALL_COMPLETED" | tee -a "$LOG"
exit 0
